{
  "name": "expressshop",
  "version": "0.4.0",
  "private": true,
  "description": "Projet fil rouge du module Qualité logicielle et tests automatisés",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "newman": "newman run postman/expressshop.postman_collection.json --env-var baseUrl=http://localhost:3000",
    "lint": "eslint . --max-warnings 0",
    "e2e": "playwright test"
  },
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testcontainers/postgresql": "12.2.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "newman": "6.2.3",
    "supertest": "7.3.1"
  }
}
