{
  "info": {
    "name": "ExpressShop API",
    "description": "Tests de l'API ExpressShop, à lancer avec Newman. Variable à fournir : baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Lister les produits",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('le code est 200', () => pm.response.to.have.status(200));",
              "pm.test('il y a 3 produits', () => pm.expect(pm.response.json()).to.have.lengthOf(3));",
              "const productSchema = { type: 'object', required: ['id', 'name', 'price', 'stock'], properties: { id: { type: 'integer' }, name: { type: 'string' }, price: { type: 'number' }, stock: { type: 'integer' } } };",
              "pm.test('chaque produit respecte le schéma', () => pm.response.to.have.jsonSchema({ type: 'array', items: productSchema }));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Lire le produit 3 (stock avant commande)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "3"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('le code est 200', () => pm.response.to.have.status(200));",
              "pm.test('c\\'est le Câble USB', () => pm.expect(pm.response.json().name).to.eql('Câble USB'));",
              "pm.collectionVariables.set('stockAvant', pm.response.json().stock);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Lire un produit inconnu",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "999"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('le code est 404', () => pm.response.to.have.status(404));",
              "pm.test('le message est Produit introuvable', () => pm.expect(pm.response.json().error).to.eql('Produit introuvable'));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Commander 2 câbles USB",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerEmail\": \"sara@test.tn\",\n  \"items\": [\n    {\n      \"productId\": 3,\n      \"quantity\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('le code est 201', () => pm.response.to.have.status(201));",
              "pm.test('le total est 39.98', () => pm.expect(pm.response.json().total).to.eql(39.98));",
              "pm.test('la commande est confirmed', () => pm.expect(pm.response.json().status).to.eql('confirmed'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Le stock a diminué de 2",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/3",
          "host": [
            "{{baseUrl}}"
          ],
