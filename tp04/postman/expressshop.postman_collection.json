      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('le stock a baissé de 2', () => pm.expect(pm.response.json().stock).to.eql(Number(pm.collectionVariables.get('stockAvant')) - 2));"
            ]
          }
        }
      ]
    },
